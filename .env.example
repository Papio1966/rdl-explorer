# RDL Explorer PostgreSQL connection.
# Do not commit credentials. Override this value in your local shell/deployment environment.
RDL_DATABASE_URL=postgresql://localhost:5432/rdl_explorer

# Controlled server-side read selection. Safe default is snapshot.
# Allowed values: snapshot | postgresql | dual
RDL_READ_MODE=snapshot

# RDL-012 governance identity verification.
# This secret is server-only and is shared with the trusted upstream identity gateway/BFF that signs reviewer headers.
# The gateway MUST strip any client-supplied x-rdl-* identity headers before adding its signed assertion.
RDL_GOVERNANCE_AUTH_SECRET=

# RDL-013 production PostgreSQL runtime.
# These settings are server-only. The browser must never receive them.
RDL_DATABASE_POOL_MAX=10
RDL_DATABASE_IDLE_TIMEOUT_MS=30000
RDL_DATABASE_CONNECTION_TIMEOUT_MS=5000
RDL_DATABASE_SSL=false
RDL_DATABASE_SSL_REJECT_UNAUTHORIZED=true

# RDL-014 operational hardening.
# Rate limiting is a per-runtime defensive guard. Apply a distributed gateway/WAF rate limit in production as well.
RDL_GOVERNANCE_RATE_LIMIT_PER_MINUTE=120
# Optional release identifier returned by /api/health (for example a deployment or Git commit identifier).
RDL_RELEASE_ID=
# Set by the hosting environment for strict production validation where VERCEL_ENV is unavailable.
# Allowed operational value: production
RDL_RUNTIME_ENV=

# RDL-015 non-secret build metadata (populate in deployment pipeline where supported).
# RDL_RELEASE_ID above is reused by /api/version and /api/health.
RDL_BUILD_VERSION=0.0.0
RDL_COMMIT_SHA=
RDL_BUILD_TIMESTAMP=

# RDL-027 enterprise SSO/OIDC gateway boundary
RDL_SSO_GATEWAY_SECRET=
RDL_IDENTITY_BOOTSTRAP_ADMINS=
